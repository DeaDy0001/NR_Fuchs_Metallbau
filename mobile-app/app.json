{
  "expo": {
    "name": "Fuchs Metallbau",
    "slug": "fuchs-metallbau",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fuchsmetallbau.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "scheme": "com.fuchsmetallbau.app",
    "plugins": [
      "./plugins/withCleartextTraffic",
      [
        "expo-camera",
        {
          "cameraPermission": "Erlaubt der App, Fotos aufzunehmen."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Erlaubt der App, auf deine Fotos zuzugreifen.",
          "savePhotosPermission": "Erlaubt der App, Fotos zu speichern.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Erlaubt der App, deinen Standort für die Foto-Dokumentation zu verwenden."
        }
      ]
    ]
  }
}
