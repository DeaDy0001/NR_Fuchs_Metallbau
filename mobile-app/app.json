{
  "expo": {
    "name": "Fuchs Metallbau",
    "slug": "fuchs-metallbau",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.fuchsmetallbau.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Erlaubt der App, Fotos aufzunehmen."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Erlaubt der App, auf deine Fotos zuzugreifen.",
          "savePhotosPermission": "Erlaubt der App, Fotos zu speichern.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
