PORT=3001
NODE_ENV=production
UPLOAD_DIR=../uploads
THUMBNAIL_DIR=../uploads/thumbnails

# Google OAuth Credentials (REQUIRED for Drive sync)
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Mobile App OAuth (REQUIRED for mobile Google Sign-In)
# Create a "Desktop app" type OAuth client ID in Google Cloud Console
# (Desktop app type supports custom scheme redirects needed by mobile apps)
GOOGLE_MOBILE_CLIENT_ID=your_mobile_client_id_here.apps.googleusercontent.com
GOOGLE_MOBILE_CLIENT_SECRET=your_mobile_client_secret_here
